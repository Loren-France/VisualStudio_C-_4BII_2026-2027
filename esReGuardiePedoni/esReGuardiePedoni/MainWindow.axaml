<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="esReGuardiePedoni.MainWindow"
        Title="esReGuardiePedoni"
        RequestedThemeVariant="Light">
    <ScrollViewer>
        <StackPanel>
            <Grid ColumnDefinitions="*,*" RowDefinitions="*,*">
                <StackPanel Name="stpVisualizza" Grid.Column="0" Grid.Row="0">
                </StackPanel>
                
                <StackPanel Name="stpAzioni" Grid.Column="1" Grid.Row="0">
                    <ListBox Name="lstInput" Height="200" Width="300" Margin="10"/>
                    <ListBox Name="lstOutput" Height="200" Width="300" Margin="10"/>
                </StackPanel>

                <StackPanel Name="stpInterfaccia" Grid.Column="0" Grid.Row="1">
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
