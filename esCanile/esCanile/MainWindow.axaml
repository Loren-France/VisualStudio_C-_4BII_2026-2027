<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:system="using:System"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="esCanile.MainWindow"
        Title="esCanile">
        <ScrollViewer>
            <StackPanel Margin="20" Spacing="15">
                <TextBlock Text="Gestionale canile" FontSize="30" FontWeight="Bold"></TextBlock>
                <Separator></Separator>
                <TextBlock Text="Inserisci i dati del cane: "></TextBlock>
                <StackPanel Spacing="10">
                    <TextBlock Text="Nome:"></TextBlock>
                    <TextBox Name="txtNome"></TextBox>
                    <TextBlock Text="Età:"></TextBlock>
                    <TextBox Name="txtEtà"></TextBox>
                    <TextBlock Text="Razza:"></TextBlock>
                    <ComboBox Name="cmbRazza" PlaceholderText="--Seleziona una razza--" Width="260"></ComboBox>
                    <TextBlock Text="Data:"></TextBlock>
                    <CalendarDatePicker Name="calData" PlaceholderText="--Seleziona una data--" Width="260"></CalendarDatePicker>
                    <TextBlock Text="Stato:"></TextBlock>
                    <RadioButton Name="In_salute" Content="In salute"></RadioButton>
                    <RadioButton Name="Malato" Content="Malato"></RadioButton>
                    <TextBlock Text="Descrizione:"></TextBlock>
                    <TextBox Name="txtDescrizione"></TextBox>
                </StackPanel>
                <Grid ColumnDefinitions="150,1.5*,4*" RowDefinitions="Auto,Auto,Auto"  Margin="4">
                    <Button Grid.Row="0" Grid.Column="0" Name="btnAggiungi" Content="Aggiungi Cane" Click="btnAggiungi_Click"></Button>
                    <Button Grid.Row="0" Grid.Column="1" Name="btnAdotta" Content="Adotta Cane" Click="btnAdotta_Click"></Button>
                </Grid>
                <TextBlock Name="txtMessage" IsVisible="False" FontWeight="Bold"></TextBlock>
                <Separator></Separator>
                <TextBlock Text="Elenco cani:" FontWeight="Bold"/>
                <ListBox Name="lstCani" Height="200"/>
            </StackPanel>   
        </ScrollViewer>
</Window>
