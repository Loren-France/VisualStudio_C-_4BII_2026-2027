<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="esBattagliaNavale.UCPosizionamento">
    <ScrollViewer>
        <StackPanel>
            <TextBlock Name="txtIstruzioni" Text="Posiziona le navi: " FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" Margin="5"/>
            <UniformGrid Name="ugCampo" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                <RadioButton Name="rbOrizzontale" Content="Orizzontale" IsChecked="True" Margin="5"/>
                <RadioButton Name="rbVerticale" Content="Verticale" Margin="5"/>
            </StackPanel>
            <TextBlock Name="txtNavi" Text="Navi da posizionare: " FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" Margin="5"/>
            <ListBox Name="lstNavi" Height="200" Margin="10"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
