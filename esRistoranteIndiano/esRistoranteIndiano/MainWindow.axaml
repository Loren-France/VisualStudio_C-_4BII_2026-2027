<Window xmlns="https://github.com/avaloniaui"
	        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	        mc:Ignorable="d"
	        d:DesignWidth="1200"
	        d:DesignHeight="900"
	        x:Class="esRistoranteIndiano.MainWindow"
	        Title="Ristorante Indiano">
	<ScrollViewer>
		<Grid RowDefinitions="Auto,*,*">

			<Border Background="#D35400">
				<TextBlock Text="🍛 Ristorante Indiano" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="10"/>
			</Border>

			<Grid Grid.Row="1" ColumnDefinitions="*,*,*" Margin="10">

				<Border Grid.Column="0" Margin="5" Padding="10" BorderThickness="1">
					<StackPanel>
						<TextBlock Text="Menù" FontSize="20" FontWeight="Bold"/>
						<ListBox Name="lstMenù" Height="400"/>
						<TextBlock Text="Quantità"/>
						<NumericUpDown Name="NudQuantita" Maximum="99" Minimum="1" Value="1"/>
						<Button Name="btnAggiungiPiatto" Content="Aggiungi all'Ordine" Click="btnAggiungiPiatto_Click"/>
						<TextBlock Name="txtErrorPiatto" Foreground="Red"/>
					</StackPanel>
				</Border>

				<Border Grid.Column="1" Margin="5" Padding="10" BorderThickness="1">
					<StackPanel>
						<TextBlock Text="Tavoli" FontSize="20" FontWeight="Bold"/>
						<ListBox Name="lstTavoli" Height="300" SelectionChanged="lstTavoli_SelectionChanged"/>
						<TextBlock Text="Numero Clienti"/>
						<NumericUpDown Name="NudNumClienti" Maximum="99" Minimum="1" Value="1"/>
						<TextBlock Name="txtErrorTavolo" Foreground="Red"/>
						<Button Name="btnOccupaTavolo" Content="Occupa Tavolo" Click="btnOccupaTavolo_Click"/>
					</StackPanel>
				</Border>

				<Border Grid.Column="2" Margin="5" Padding="10" BorderThickness="1">
					<StackPanel>
						<TextBlock Text="Ordine Corrente" FontSize="20" FontWeight="Bold"/>
						<TextBlock Name="txtInfoTavolo" Margin="0,5,0,5"/>
						<TextBox Name="txtInfoOrdine" IsReadOnly="True" Height="300"/>
						<TextBlock Name="txtTotale" Text="Totale: 0 €" FontSize="18" FontWeight="Bold" Margin="0,10,0,5"/>
						<Button Name="btnChiudiConto" Content="Chiudi Conto" Margin="0,10,0,0" Click="btnChiudiConto_Click"/>
					</StackPanel>
				</Border>

			</Grid>

			<Border Grid.Row="2" Margin="10" Padding="10" BorderThickness="1">
				<StackPanel>
					<TextBlock Text="Storico Ordini" FontSize="20" FontWeight="Bold"/>
					<ListBox Name="lstStorico"/>
				</StackPanel>
			</Border>

		</Grid>
	</ScrollViewer>
</Window>